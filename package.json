{
  "name": "tableau-public-mcp-app",
  "version": "0.3.0",
  "private": true,
  "description": "MCP Apps server that embeds a Tableau Public viz in chat and shares the user's interaction state back to the model",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:view": "node scripts/build-view.mjs",
    "build": "npm run build:view && tsc -p tsconfig.json",
    "dev": "npm run build:view && tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "npm run build:view && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
